{
  "services": {
    "prognexa-backend": {
      "build": {
        "context": "./backend",
        "dockerfile": "Dockerfile"
      },
      "ports": [
        {
          "port": 8000,
          "protocol": "HTTP",
          "public": true
        }
      ],
      "environment": {
        "MONGO_USERNAME": "sysadmin_root",
        "MONGO_PASSWORD": "password123",
        "DB_NAME": "prognexa_db",
        "JWT_SECRET_KEY": "edae6bcb155d8c23bea67a7eed2c39c2a4a8653a1a31bb0b789c8ebaf28b5e33",
        "ALGORITHM": "HS256",
        "ACCESS_TOKEN_EXPIRE_MINUTES": "60",
        "MONGO_URI": "mongodb://sysadmin_root:password123@prognexa-db:27017/"
      },
      "resources": {
        "instance": "nf-compute-15"
      }
    },
    "prognexa-frontend": {
      "build": {
        "context": "./frontend",
        "dockerfile": "Dockerfile"
      },
      "ports": [
        {
          "port": 80,
          "protocol": "HTTP",
          "public": true
        }
      ],
      "environment": {
        "API_BASE": "http://backend:8000"
      },
      "resources": {
        "instance": "nf-compute-15"
      }
    }
  }
}
